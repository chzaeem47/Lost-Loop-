.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release


# Flutter / Dart generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/

# Generated plugin registrants
# Keep platform-specific generated registrants unless
# the Flutter template explicitly ignores them.

# Android generated/build files
android/.gradle/
android/local.properties
android/**/build/
android/captures/
android/key.properties
android/*.jks
android/*.keystore

# iOS generated/build files
ios/Flutter/.last_build_id
ios/Flutter/ephemeral/
ios/Pods/
ios/.symlinks/
ios/Runner/GeneratedPluginRegistrant.*

# Web build output
# Flutter's generated web files are generally tracked;
# ignore only the compiled output above via build/

# IDE settings
.idea/
.vscode/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp

# Secrets and environment variables
.env
.env.*
!.env.example
!.env.sample

# Signing credentials / private keys
*.pem
*.key
serviceAccountKey.json
google-services.json
GoogleService-Info.plist
